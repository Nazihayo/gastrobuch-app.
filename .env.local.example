NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Used to build the email-confirmation redirect link. Set this to your real
# deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Powers the AI Assistant (/assistant). Get a key at https://console.anthropic.com/ —
# without it, the assistant page shows a friendly "not configured" message
# instead of crashing.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Powers the "enhance as food photo" button in Recipe costing, which turns a
# quick snapshot into a cleaner-looking dish photo. Get a key at
# https://platform.openai.com/ — without it, the button shows a friendly
# "not configured" message instead of crashing. Each use costs a small
# amount on your OpenAI account (gpt-image-1 image edits).
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Powers online payment (Stripe Connect) — lets each restaurant connect its
# own Stripe account from /profile so guests can pay directly online.
# Without these, the "connect Stripe account" button shows a friendly
# "not configured" message instead of crashing.
#
# Setup (one-time, on https://dashboard.stripe.com/):
#   1. Create your own platform Stripe account (this is YOUR account, the
#      app's — not a restaurant's). Enable Connect under Settings > Connect.
#   2. Get your secret key from Developers > API keys.
#   3. Create a webhook endpoint at <your-site-url>/api/stripe/webhook,
#      listening for "checkout.session.completed". Since payments happen on
#      each restaurant's own connected Stripe account, ALSO register this
#      same URL under Connect > Webhooks (events on connected accounts) —
#      a normal webhook alone will not receive these events.
#   4. Copy the webhook's signing secret below.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
