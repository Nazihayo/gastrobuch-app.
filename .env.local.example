NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Used to build the email-confirmation redirect link. Set this to your real
# deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Powers the AI Assistant (/assistant). Get a key at https://console.anthropic.com/ —
# without it, the assistant page shows a friendly "not configured" message
# instead of crashing.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Powers the "enhance as food photo" button in Recipe costing, which turns a
# quick snapshot into a cleaner-looking dish photo. Get a key at
# https://platform.openai.com/ — without it, the button shows a friendly
# "not configured" message instead of crashing. Each use costs a small
# amount on your OpenAI account (gpt-image-1 image edits).
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Powers online payment (Stripe Connect) — lets each restaurant connect its
# own Stripe account from /profile so guests can pay directly online.
# Without these, the "connect Stripe account" button shows a friendly
# "not configured" message instead of crashing.
#
# The same webhook route also handles GastroHub's own platform subscription
# billing (see STRIPE_SUBSCRIPTION_PRICE_ID below) — two different kinds of
# Stripe events land on the same endpoint, which is why it must be
# registered TWICE in the Stripe Dashboard (see step 3).
#
# Setup (one-time, on https://dashboard.stripe.com/):
#   1. Create your own platform Stripe account (this is YOUR account, the
#      app's — not a restaurant's). Enable Connect under Settings > Connect.
#   2. Get your secret key from Developers > API keys.
#   3. Create a webhook endpoint at <your-site-url>/api/stripe/webhook,
#      listening for "checkout.session.completed", "customer.subscription.updated",
#      and "customer.subscription.deleted" — this normal (platform) webhook
#      is what delivers subscription billing events. Since restaurant guest
#      payments happen on each restaurant's own CONNECTED Stripe account
#      instead, ALSO register this exact same URL a second time under
#      Connect > Webhooks (events on connected accounts), listening for
#      "checkout.session.completed" there too — a normal webhook alone will
#      not receive those connected-account events.
#   4. Copy the (normal) webhook's signing secret below — both event
#      sources are verified with this one secret since they hit the same URL.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Powers GastroHub's OWN revenue: a flat monthly subscription each
# restaurant pays to use the app (separate from Stripe Connect above, which
# only ever moves a restaurant's own customer payments, never GastroHub's).
# Without this, the "subscribe" button on /billing shows a friendly
# "not configured" message instead of crashing.
#
# Setup (one-time, on https://dashboard.stripe.com/, same platform account
# as above):
#   1. Go to Product catalog > Add product. Create a recurring Price
#      (e.g. EUR 49.00 / month).
#   2. Copy that Price's ID (starts with "price_") below.
STRIPE_SUBSCRIPTION_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx
